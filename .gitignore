# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# The runner writes these into a check's working directory, and they should
# never survive into a task tree.
.gavel.stdout
.gavel.stderr
.gavel-work/

# A soak writes tens of megabytes of episodes and a cache beside them. The
# report is worth keeping and the trajectory is not: it is derived, and the
# seeds that produce it are in the report.
runs/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Per-worker authoring manifests. They are build intermediates -- a round's
# manifest survives only until the round is collapsed into manifest.json, which
# tools.author does by re-running each task against it. Kept out of the repo
# root, where a stale one sitting beside the real manifest.json is how the
# wrong file gets published.
scratch/

# OS
.DS_Store
